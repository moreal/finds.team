{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	@backend path /graphql /auth/* /webauthn/* /login/webauthn

	handle @backend {
		header X-Finds-Upstream backend
		reverse_proxy backend:8080 {
			header_up X-Request-ID {http.request.header.X-Request-ID}
		}
	}

	handle {
		header X-Finds-Upstream frontend
		reverse_proxy frontend:3000 {
			header_up X-Request-ID {http.request.header.X-Request-ID}
		}
	}
}
