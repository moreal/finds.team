scalar DateTime

interface Node { id: ID! }

enum UserRole { USER ADMIN }
type User implements Node { id: ID!, roles: [UserRole!]! }
type Viewer {
  user: User!
  passkeys(first: Int = 20, after: String): PasskeyConnection!
  sessions(first: Int = 20, after: String): SessionConnection!
}
type Passkey { id: ID!, label: String!, createdAt: DateTime!, lastUsedAt: DateTime }
type Session { id: ID!, createdAt: DateTime!, expiresAt: DateTime!, current: Boolean! }
type PasskeyEdge { cursor: String!, node: Passkey! }
type SessionEdge { cursor: String!, node: Session! }
type PasskeyConnection { edges: [PasskeyEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }
type SessionConnection { edges: [SessionEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }
type Skill implements Node {
  id: ID!
  slug: String!
  displayName: String!
  companies(orderBy: CareerSiteOrder = ID_ASC, first: Int = 20, after: String): CareerSiteConnection!
  openPostings(orderBy: PostingOrder = UPDATED_DESC, first: Int = 20, after: String): JobPostingConnection!
  requirementCounts: SkillRequirementCounts!
  relatedSkills(orderBy: SkillOrder = SLUG_ASC, first: Int = 20, after: String): SkillConnection!
}
type CrawlRun implements Node {
  id: ID!
  careerSiteId: ID!
  startedAt: DateTime!
  finishedAt: DateTime
  outcome: CrawlOutcome
  counts: CrawlChangeCounts!
  error: ApiError
}
type CrawlRunEdge { cursor: String!, node: CrawlRun! }
type CrawlRunConnection { edges: [CrawlRunEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }
type CrawlSummary { outcome: CrawlOutcome, finishedAt: DateTime }
enum AuditActorKind { USER SYSTEM }
enum AuditAction {
  ROLE_GRANTED ROLE_REVOKED CAREER_SITE_REGISTERED CAREER_SITE_SETTINGS_CHANGED MANUAL_CRAWL_TRIGGERED
  PASSKEY_REGISTERED PASSKEY_REMOVED PASSKEY_RENAMED RECOVERY_CODE_ROTATED ACCOUNT_RECOVERY_COMPLETED
  SESSION_REVOKED ADMIN_CONFIGURATION_CHANGED
}
enum AuditOutcome { SUCCEEDED }
type AuditDetails { role: UserRole, provider: SourceProvider, enabled: Boolean }
type AuditEvent implements Node {
  id: ID!
  occurredAt: DateTime!
  actorKind: AuditActorKind!
  actorUserId: ID
  action: AuditAction!
  targetType: String!
  targetId: String!
  outcome: AuditOutcome!
  details: AuditDetails!
}
input AuditFilterInput {
  "CareerSite global ID; selects career_site records only. Cannot combine with targetType or targetId."
  atCareerSite: ID
  actorUserId: ID
  actorKind: AuditActorKind
  action: AuditAction
  targetType: String
  targetId: String
  from: DateTime
  until: DateTime
}
type AuditEventEdge { cursor: String!, node: AuditEvent! }
type AuditEventConnection { edges: [AuditEventEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }

enum SourceProvider { FLEX GREETING NINEHIRE }
enum PostingStatus { OPEN CLOSED }
enum CrawlOutcome { SUCCESS FAILED }
enum SkillRequirementLevel { REQUIRED PREFERRED MENTIONED }
enum RoleCategory { BACKEND FRONTEND FULLSTACK MOBILE DATA DEVOPS DESIGN PRODUCT QA UNKNOWN }
enum EmploymentType { FULL_TIME PART_TIME CONTRACT INTERNSHIP UNKNOWN }
enum RemotePolicy { REMOTE HYBRID ONSITE UNKNOWN }
enum PostingOrder { UPDATED_DESC }
enum CareerSiteOrder { ID_ASC }
enum SkillOrder { SLUG_ASC }

enum ApiErrorCode {
  INVALID_INPUT
  INVALID_FILTER
  UNKNOWN_SKILL
  INVALID_CURSOR
  INVALID_PAGE
  INVALID_URL
  UNSUPPORTED_PROVIDER
  AMBIGUOUS_PROVIDER
  DISCOVERY_FAILED
  ALREADY_REGISTERED
  NOT_FOUND
  NOT_DUE
  DISABLED
  BUSY
  CRAWL_FAILED
  INTERNAL
  FORBIDDEN
  ACCOUNT_MISMATCH
  IDEMPOTENCY_CONFLICT
  LAST_CREDENTIAL
}

type ApiError {
  code: ApiErrorCode!
  message: String!
  providers: [SourceProvider!]!
}

input PostingFilterInput {
  atSite: ID
  textContains: String
  hasStatus: PostingStatus
  updatedAfter: DateTime
  hasSkill: SkillFilterInput
  hasRole: RoleCategory
  hasEmployment: EmploymentType
  hasRemotePolicy: RemotePolicy
  atLocation: String
  not: PostingFilterInput
  all: [PostingFilterInput!]
  any: [PostingFilterInput!]
}
input SkillFilterInput { slug: String!, level: SkillRequirementLevel }
type DiscoveryError { code: ApiErrorCode!, message: String! }
type ClassifiedRole { value: RoleCategory!, rawValue: String }
type ClassifiedEmployment { value: EmploymentType!, rawValue: String }
type ClassifiedRemotePolicy { value: RemotePolicy!, rawValue: String }
type NormalizedLocation { displayName: String!, searchValue: String! }
type PostingSkill { skill: Skill, text: String!, level: SkillRequirementLevel! }
type PostingClassification {
  taxonomyVersion: Int!
  skills: [PostingSkill!]!
  role: ClassifiedRole!
  employment: ClassifiedEmployment!
  remote: ClassifiedRemotePolicy!
  location: NormalizedLocation
}
type SkillRequirementCounts { required: Int!, preferred: Int!, mentioned: Int! }

type JobPosting implements Node {
  id: ID!
  careerSiteId: ID!
  externalKey: String!
  title: String!
  descriptionText: String!
  canonicalUrl: String!
  status: PostingStatus!
  employmentHint: String
  locationHint: String
  remoteHint: String
  sourceUpdatedAt: DateTime
  firstSeenAt: DateTime!
  lastSeenAt: DateTime!
  updatedAt: DateTime!
  closedAt: DateTime
  careerSite: CareerSite!
  classification: PostingClassification
}

type JobPostingEdge { cursor: String!, node: JobPosting! }
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}
type JobPostingConnection {
  edges: [JobPostingEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
  error: DiscoveryError
}
type CareerSiteEdge { cursor: String!, node: CareerSite! }
type CareerSiteConnection { edges: [CareerSiteEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }
type SkillEdge { cursor: String!, node: Skill! }
type SkillConnection { edges: [SkillEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }

type CareerSite implements Node {
  id: ID!
  slug: String!
  canonicalBaseUrl: String!
  host: String!
  provider: SourceProvider!
  displayName: String!
  enabled: Boolean!
  successfulIntervalSeconds: Int!
  openPostings(orderBy: PostingOrder = UPDATED_DESC, first: Int = 20, after: String): JobPostingConnection!
  crawlSummary: CrawlSummary
  crawlHistory(first: Int = 20, after: String): CrawlRunConnection!
}

input RegisterCareerSiteInput { url: String!, displayName: String!, idempotencyKey: ID!, clientMutationId: String }
type RegisterCareerSitePayload { site: CareerSite, error: ApiError, clientMutationId: String }
input TriggerCrawlInput { careerSiteId: ID!, idempotencyKey: ID!, clientMutationId: String }
input RenamePasskeyInput { expectedUserId: ID!, passkeyId: ID!, label: String!, idempotencyKey: ID!, clientMutationId: String }
input RemovePasskeyInput { expectedUserId: ID!, passkeyId: ID!, idempotencyKey: ID!, clientMutationId: String }
input RevokeSessionInput { expectedUserId: ID!, sessionId: ID!, idempotencyKey: ID!, clientMutationId: String }
input SecurityCommandInput { expectedUserId: ID!, idempotencyKey: ID!, clientMutationId: String }
enum SecurityChangeOutcome { CHANGED UNCHANGED SIGNED_OUT ROTATED ALREADY_ROTATED REJECTED }
type SecurityChangePayload { outcome: SecurityChangeOutcome!, error: ApiError, clientMutationId: String }
type RotateRecoveryCodePayload { outcome: SecurityChangeOutcome!, recoveryCode: String, error: ApiError, clientMutationId: String }

enum CrawlTriggerOutcome {
  TRIGGERED FORBIDDEN INVALID_INPUT IDEMPOTENCY_CONFLICT
  SUCCEEDED FAILED NOT_FOUND NOT_DUE DISABLED BUSY INFRASTRUCTURE_FAILURE
}

type CrawlChangeCounts {
  fetched: Int!
  inserted: Int!
  updated: Int!
  touched: Int!
  missing: Int!
  closed: Int!
  reopened: Int!
}

type TriggerCrawlPayload {
  clientMutationId: String
  outcome: CrawlTriggerOutcome!
  runId: ID
  counts: CrawlChangeCounts
  nextEligibleAt: DateTime
  error: ApiError
}

type CrawlStatus {
  careerSiteId: ID!
  runId: ID
  outcome: CrawlOutcome
  finishedAt: DateTime
  error: ApiError
}
type CrawlStatusEdge { cursor: String!, node: CrawlStatus! }
type CrawlStatusConnection { edges: [CrawlStatusEdge!]!, pageInfo: PageInfo!, totalCount: Int!, error: DiscoveryError }

type Query {
  node(id: ID!): Node
  jobPosting(id: ID!): JobPosting
  jobPostings(filter: PostingFilterInput, orderBy: PostingOrder = UPDATED_DESC, first: Int = 20, after: String): JobPostingConnection!
  careerSite(slug: String!): CareerSite
  careerSites(orderBy: CareerSiteOrder = ID_ASC, first: Int = 20, after: String): CareerSiteConnection!
  skill(slug: String!): Skill
  skills(query: String, orderBy: SkillOrder = SLUG_ASC, first: Int = 20, after: String): SkillConnection!
  viewer: Viewer
  crawlStatuses(first: Int = 50, after: String): CrawlStatusConnection!
  auditEvents(filter: AuditFilterInput, first: Int = 50, after: String): AuditEventConnection!
}

type Mutation {
  registerCareerSite(input: RegisterCareerSiteInput!): RegisterCareerSitePayload!
  triggerCrawl(input: TriggerCrawlInput!): TriggerCrawlPayload!
  renamePasskey(input: RenamePasskeyInput!): SecurityChangePayload!
  removePasskey(input: RemovePasskeyInput!): SecurityChangePayload!
  rotateRecoveryCode(input: SecurityCommandInput!): RotateRecoveryCodePayload!
  revokeSession(input: RevokeSessionInput!): SecurityChangePayload!
  revokeOtherSessions(input: SecurityCommandInput!): SecurityChangePayload!
}
